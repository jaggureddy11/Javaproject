# Environment Configuration for RouteResQ

# Application
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=routeresq_db
DB_USER=routeresq_user
DB_PASSWORD=routeresq_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
JWT_SECRET=super-secret-key-that-is-at-least-256-bits-long-for-hmac-sha-256-security-routeresq-2026
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Optimization & Routing
SOLVER_MAX_SECONDS=10
ROUTING_PROVIDER=HAVERSINE
OSRM_SERVER_URL=http://router.project-osrm.org
